<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.libiao</groupId>
        <artifactId>lb-learn1</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>lb-learn1-infrastructure</artifactId>
    <name>lb-learn1-infrastructure</name>
    <description>Mapper / DAO、Redis、持久层与缓存配置、安全领域适配</description>

    <dependencies>
        <dependency>
            <groupId>com.libiao</groupId>
            <artifactId>lb-learn1-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.libiao</groupId>
            <artifactId>lb-learn1-domain</artifactId>
        </dependency>
        <!-- CartMapper / OrderMapper 直接返回 DTO/VO -->
        <dependency>
            <groupId>com.libiao</groupId>
            <artifactId>lb-learn1-api</artifactId>
        </dependency>

        <!-- MyBatis-Plus：BaseMapper / LambdaQueryWrapper / 分页插件 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>

        <!-- Redis：TokenBlackService 依赖 RedisTemplate -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- application.yaml 里配置了 lettuce.pool，必须引入连接池实现 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>
        <!-- RedisConfig 自定义序列化用到 Jackson（原来是随 spring-boot-starter-web 间接传递的） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>

        <!-- UserDetailsServiceImpl 需要 UserDetails / GrantedAuthority 等类型 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

</project>
