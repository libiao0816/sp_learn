<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.libiao</groupId>
        <artifactId>lb-learn1</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>lb-learn1-bootstrap</artifactId>
    <name>lb-learn1-bootstrap</name>
    <description>Controller、启动类、Web/Security 配置、全局异常处理、配置文件与静态资源</description>

    <dependencies>
        <dependency>
            <groupId>com.libiao</groupId>
            <artifactId>lb-learn1-application</artifactId>
        </dependency>
        <!-- 持久层实现（MyBatis mapper 注册与 Redis 配置） -->
        <dependency>
            <groupId>com.libiao</groupId>
            <artifactId>lb-learn1-infrastructure</artifactId>
        </dependency>
        <!-- 安全组件统一收敛在 security 模块（SecurityConfig / 过滤器 / JWT） -->
        <dependency>
            <groupId>com.libiao</groupId>
            <artifactId>lb-learn1-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- 接口文档 UI -->
        <dependency>
            <groupId>com.baizhukui</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 只有启动模块需要打成可执行 fat-jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
