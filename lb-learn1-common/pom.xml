<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.libiao</groupId>
        <artifactId>lb-learn1</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>lb-learn1-common</artifactId>
    <name>lb-learn1-common</name>
    <description>工具类、通用异常、返回体、枚举（最底层，不依赖任何业务模块）</description>

    <dependencies>
        <!-- @Component / @ConfigurationProperties 需要 Spring 容器与 Boot 的配置绑定能力 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- JwtUtil 的签发与解析（jjwt-impl / jjwt-jackson 由 bootstrap 运行时提供） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>

        <!-- Result / PageResult 上的 @Schema 注解；同时供 api 模块传递使用 -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
        </dependency>

        <!-- AuthTokenUtils 参数用到 jakarta.servlet 的 HttpServletRequest；
             仅编译期需要，运行期由 Servlet 容器提供，故用 provided -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

</project>
